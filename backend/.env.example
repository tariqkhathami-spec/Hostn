PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/hostn

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# File upload (optional - for cloud storage later)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Integration keys from the admin dashboard (/admin/integrations).
# Encrypts the saved keys. 32+ random characters (openssl rand -base64 48).
# Set it once and never change it: saved keys are decrypted with it.
SECRETS_MASTER_KEY=

# AI assistant (can also be set from the admin dashboard)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
